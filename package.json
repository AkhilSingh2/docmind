{
  "name": "docmind",
  "version": "1.0.0",
  "private": true,
  "description": "Research agent that answers from your documents with inline citations and visible tool calls. Runs in demo mode with no API keys.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval": "tsx lib/eval/run.ts",
    "db:push": "drizzle-kit push"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.108",
    "@ai-sdk/openai": "^4.0.123",
    "@ai-sdk/react": "^4.0.186",
    "ai": "^7.0.181",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.80.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "unpdf": "^1.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.2"
  }
}
