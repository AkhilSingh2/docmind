# DocMind runs with no secrets. Leave LLM_PROVIDER=mock for the recruiter demo.

# mock | openai | anthropic | ollama
LLM_PROVIDER=mock

# local (JSON file, default) | pgvector (requires DATABASE_URL and docker compose)
VECTOR_STORE=local

# Used by the local hashing embedder and the pgvector column width.
# If you switch to OpenAI embeddings, set this to 1536 and recreate the database.
EMBEDDING_DIMENSIONS=256
# hash | openai
EMBEDDING_PROVIDER=hash

# Optional Postgres + pgvector. See docker-compose.yml.
# DATABASE_URL=postgres://docmind:docmind@localhost:5432/docmind

# --- Real models (only when LLM_PROVIDER is not mock) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Optional shared passphrase. When unset, the app is open.
# DOCMIND_ACCESS_KEY=

# Milliseconds between streamed tokens in demo mode. Use 0 in tests.
MOCK_STREAM_DELAY_MS=12
